# container.env — single source of truth for which container the camera /
# watchdog / autostart stack manages, and which image it was launched from.
#
# Read by (host side):
#   - start_ros2_nodes.sh
#   - watch_container_start.sh
#   - astra_watchdog.sh
#   - oak_watchdog.sh
#   - run_container.sh / swap_container.sh
# And referenced by the systemd units via EnvironmentFile=.
#
# swap_container.sh REWRITES this file on a successful swap so the whole
# stack repoints at the new container atomically. Edit by hand only if
# you know what you're doing; prefer swap_container.sh.

CONTAINER=yahboom_ros2_humble
IMAGE=yahboom_ros2_humble:v1.0-dev
